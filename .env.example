# Gibwork / Solana
SOLANA_PRIVATE_KEY=
GIBWORK_ENVIRONMENT=stage          # stage | production
DRY_RUN=true

# Agent behaviour
MIN_REWARD=10.00
MAX_REWARD=500.00
PREFERRED_TAGS=typescript,react,solana,docs,bug
SKILLS=typescript,nodejs,react,solana,documentation
MAX_CONCURRENT=3
STATE_DIR=./state

# Optional notification
DISCORD_WEBHOOK_URL=
